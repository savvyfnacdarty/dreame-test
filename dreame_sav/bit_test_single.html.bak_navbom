let TESTS = EMBED.slice();

const _manifestLow = {};
MANIFEST.forEach(f => { _manifestLow[f.toLowerCase()] = f; });
function isHttp(v){ return /^https?:\/\//i.test(String(v||'').trim()); }
/* Nom de fichier réel (corrige casse + extension via le manifeste). */
function localName(val){
  val = String(val||'').trim();
  let real = _manifestLow[val.toLowerCase()];
  if(!real){
    for(const ext of ['.png','.jpg','.jpeg','.mov','.mp4']){
      if(_manifestLow[(val+ext).toLowerCase()]){ real = _manifestLow[(val+ext).toLowerCase()]; break; }
    }
  }
  return real || val;
}
/* Image en échec : on tente le dossier suivant ; si tous échouent, on masque
   l'image et on retire le titre orphelin si la galerie est vide. */
function imgErr(el){
  const f = el.getAttribute('data-file');
  let b = parseInt(el.getAttribute('data-b')||'0', 10);
  if(f && b+1 < MEDIA_BASES.length){            // essai du dossier suivant
    b++; el.setAttribute('data-b', b); el.src = MEDIA_BASES[b] + f; return;
  }
  el.style.display='none';
  const grid = el.closest('.img-grid');
  if(grid && !Array.from(grid.querySelectorAll('img')).some(i=>i.style.display!=='none')){
    const sec = el.closest('.tb-section'); if(sec) sec.style.display='none';
  }
}
function resolveMedia(val){
  if(!val) return '';
  val = String(val).trim();
  if(!val) return '';
  if(isHttp(val)) return val;            // URL Vimeo / SharePoint : utilisée telle quelle
  return MEDIA_BASE + encodeURI(localName(val));   // repli : fichier local (1er dossier)
}
function isVideo(name){ return /\.(mov|mp4|webm|m4v)(\?|$)/i.test(name||''); }
/* Transforme une URL Vimeo (publique/privée/embed) en URL d'intégration player. */
function vimeoEmbed(url){
  url = String(url||'').trim();
  if(/player\.vimeo\.com\/video\//i.test(url)) return url;        // déjà une URL d'intégration
  const priv = url.match(/vimeo\.com\/(\d+)\/([0-9a-zA-Z]+)/i);   // vidéo privée : /ID/HASH
  if(priv) return 'https://player.vimeo.com/video/'+priv[1]+'?h='+priv[2];
  const pub = url.match(/vimeo\.com\/(?:video\/)?(\d+)/i);        // vidéo publique : /ID
  if(pub) return 'https://player.vimeo.com/video/'+pub[1];
  return '';                                                       // pas reconnu comme Vimeo
}
function slug(s){ return String(s).trim().toLowerCase().replace(/[^a-z0-9]+/g,'-').replace(/^-|-$/g,''); }

const LS_DONE = 'fd_bit_single_done';
const LS_NA   = 'fd_bit_single_na';
let doneSet = new Set();
let naSet   = new Set();
(function(){ try{ const r=localStorage.getItem(LS_DONE); if(r) doneSet=new Set(JSON.parse(r)); }catch(e){} })();
(function(){ try{ const r=localStorage.getItem(LS_NA);   if(r) naSet  =new Set(JSON.parse(r)); }catch(e){} })();
function saveDone(){ try{ localStorage.setItem(LS_DONE, JSON.stringify([...doneSet])); }catch(e){} }
function saveNa(){   try{ localStorage.setItem(LS_NA,   JSON.stringify([...naSet]));   }catch(e){} }
/* Cocher « Test effectué » ou « Non concerné » referme la fiche. */
function toggleDone(id, on){ if(on){ doneSet.add(id); openSet.delete(id); } else doneSet.delete(id); saveDone(); render(); }
function toggleNa(id, on){   if(on){ naSet.add(id);   openSet.delete(id); } else naSet.delete(id);   saveNa();   render(); }
function resetDone(){
  doneSet.clear(); naSet.clear(); saveDone(); saveNa();
  ['rfSn','rfDossier','rfTech','rfComment'].forEach(id=>{ const el=document.getElementById(id); if(el) el.value=''; });
  saveFields();
  render(); showToast('Progression et infos export réinitialisées');
}

/* --- Champs rapport (S/N, dossier, tech) : persistés dans le navigateur --- */
const LS_FIELDS = 'fd_bit_single_fields';
function saveFields(){
  try{
    localStorage.setItem(LS_FIELDS, JSON.stringify({
      sn: (document.getElementById('rfSn')||{}).value || '',
      dossier: (document.getElementById('rfDossier')||{}).value || '',
      tech: (document.getElementById('rfTech')||{}).value || '',
      comment: (document.getElementById('rfComment')||{}).value || ''
    }));
  }catch(e){}
}
function loadFields(){
  try{
    const f = JSON.parse(localStorage.getItem(LS_FIELDS)||'{}');
    if(document.getElementById('rfSn')) document.getElementById('rfSn').value = f.sn||'';
    if(document.getElementById('rfDossier')) document.getElementById('rfDossier').value = f.dossier||'';
    if(document.getElementById('rfTech')) document.getElementById('rfTech').value = f.tech||'';
    if(document.getElementById('rfComment')) document.getElementById('rfComment').value = f.comment||'';
  }catch(e){}
}

/* --- Export d'un rapport imprimable (PDF via impression navigateur) --- */
function exportReport(){
  const sn = ((document.getElementById('rfSn')||{}).value||'').trim();
  const dossier = ((document.getElementById('rfDossier')||{}).value||'').trim();
  const tech = ((document.getElementById('rfTech')||{}).value||'').trim();
  const comment = ((document.getElementById('rfComment')||{}).value||'').trim();
  const now = new Date();
  const dateStr = now.toLocaleDateString('fr-FR') + ' ' + now.toLocaleTimeString('fr-FR',{hour:'2-digit',minute:'2-digit'});
  let nDone=0, nNa=0, nTodo=0;
  const rows = TESTS.map((t,i)=>{
    let statut, cls;
    if(doneSet.has(t.id)){ statut='Effectué'; cls='ok'; nDone++; }
    else if(naSet.has(t.id)){ statut='Non concerné'; cls='na'; nNa++; }
    else { statut='Non traité'; cls='todo'; nTodo++; }
    return '<tr><td class="c-num">'+(i+1)+'</td><td>'+escHtml(t.name)+'</td><td class="st '+cls+'">'+statut+'</td></tr>';
  }).join('');
  const field = (lbl,val)=>'<div class="rp-field"><span class="rp-lbl">'+lbl+'</span><span class="rp-val">'+escHtml(val||'—')+'</span></div>';
  const html = '<!DOCTYPE html><html lang="fr"><head><meta charset="utf-8">'
    + '<title>Rapport BIT Test'+(sn?' - '+escHtml(sn):'')+'</title><style>'
    + '*{box-sizing:border-box}body{font-family:"Segoe UI",Arial,sans-serif;color:#1a1a2e;margin:0;padding:28px 32px;font-size:13px}'
    + '.rp-head{display:flex;align-items:center;justify-content:space-between;border-bottom:3px solid #D4151B;padding-bottom:12px;margin-bottom:18px}'
    + '.rp-head h1{font-size:19px;margin:0;color:#0f3460}.rp-head .rp-sub{font-size:11px;color:#666;margin-top:3px}'
    + '.rp-head .rp-brand{font-size:15px;font-weight:800;color:#D4151B}'
    + '.rp-fields{display:flex;flex-wrap:wrap;gap:10px 26px;background:#f6f7f9;border:1px solid #e2e5ea;border-radius:8px;padding:12px 16px;margin-bottom:18px}'
    + '.rp-field{display:flex;flex-direction:column;gap:2px}.rp-lbl{font-size:10px;text-transform:uppercase;letter-spacing:.5px;color:#888;font-weight:700}'
    + '.rp-val{font-size:14px;font-weight:700}'
    + '.rp-summary{display:flex;gap:10px;margin-bottom:16px}'
    + '.rp-chip{flex:1;text-align:center;border-radius:8px;padding:10px;font-weight:700}'
    + '.rp-chip .n{display:block;font-size:22px}.rp-chip .l{font-size:10px;text-transform:uppercase;letter-spacing:.4px}'
    + '.rp-chip.ok{background:#e6f4ea;color:#1e7e34}.rp-chip.na{background:#fff3e0;color:#e07b00}.rp-chip.todo{background:#f0f1f3;color:#555}'
    + 'table{width:100%;border-collapse:collapse;font-size:12.5px}'
    + 'th{background:#0f3460;color:#fff;text-align:left;padding:8px 10px;font-size:11px;text-transform:uppercase;letter-spacing:.3px}'
    + 'td{padding:7px 10px;border-bottom:1px solid #e5e7eb}.c-num{width:34px;color:#999;text-align:center}'
    + '.st{font-weight:700;white-space:nowrap;width:120px}.st.ok{color:#1e7e34}.st.na{color:#e07b00}.st.todo{color:#999}'
    + 'tr:nth-child(even) td{background:#fafbfc}'
    + '.rp-foot{margin-top:22px;font-size:10.5px;color:#999;display:flex;justify-content:space-between;border-top:1px solid #e5e7eb;padding-top:8px}'
    + '.rp-sign{margin-top:26px;display:flex;gap:40px}.rp-sign div{flex:1;border-top:1px solid #333;padding-top:5px;font-size:11px;color:#555}'
    + '.rp-comment{margin-top:18px;border:1px solid #e2e5ea;border-radius:8px;padding:12px 16px;background:#fffdf6}'
    + '.rp-comment .rp-lbl{display:block;margin-bottom:5px}.rp-comment p{margin:0;white-space:pre-wrap;font-size:12.5px;line-height:1.5}'
    + '@media print{body{padding:0}.rp-noprint{display:none}}'
    + '</style></head><body>'
    + '<div class="rp-head"><div><h1>Rapport de test BIT &mdash; Robot Dreame / MOVA</h1><div class="rp-sub">SAV PEM &middot; BIT Test Single &middot; ' + escHtml(dateStr) + '</div></div><div class="rp-brand">FNAC&middot;DARTY</div></div>'
    + '<div class="rp-fields">' + field('N&deg; de s&eacute;rie (S/N)', sn) + field('N&deg; de dossier', dossier) + field('N&deg; technicien', tech) + field('Date', dateStr) + '</div>'
    + '<div class="rp-summary">'
    +   '<div class="rp-chip ok"><span class="n">'+nDone+'</span><span class="l">Effectu&eacute;s</span></div>'
    +   '<div class="rp-chip na"><span class="n">'+nNa+'</span><span class="l">Non concern&eacute;s</span></div>'
    +   '<div class="rp-chip todo"><span class="n">'+nTodo+'</span><span class="l">Non trait&eacute;s</span></div>'
    + '</div>'
    + '<table><thead><tr><th>#</th><th>Test</th><th>Statut</th></tr></thead><tbody>' + rows + '</tbody></table>'
    + (comment ? '<div class="rp-comment"><span class="rp-lbl">Commentaire</span><p>' + escHtml(comment) + '</p></div>' : '')
    + '<div class="rp-sign"><div>Signature technicien</div><div>Observations</div></div>'
    + '<div class="rp-foot"><span>' + TESTS.length + ' tests &middot; ' + escHtml(dateStr) + '</span><span>HUB Drive Constructeurs &middot; Fnac Darty</span></div>'
    + '<script>window.onload=function(){setTimeout(function(){window.print();},250);};<\/script>'
    + '</body></html>';
  const w = window.open('', '_blank');
  if(!w){ showToast('Autorisez les pop-ups pour exporter le rapport'); return; }
  w.document.open(); w.document.write(html); w.document.close();
}

const LS_THEME='fd_sav_theme';
function toggleTheme(){ const n=document.documentElement.dataset.theme==='dark'?'light':'dark'; applyTheme(n); try{localStorage.setItem(LS_THEME,n);}catch(e){} }
function applyTheme(t){ document.documentElement.dataset.theme=t; document.getElementById('themeToggle').textContent=t==='dark'?'☾':'☀'; }
(function(){ try{ const s=localStorage.getItem(LS_THEME); if(s) applyTheme(s); }catch(e){} })();
let _tt; function showToast(m){ const t=document.getElementById('toast'); t.textContent=m; t.classList.add('show'); clearTimeout(_tt); _tt=setTimeout(()=>t.classList.remove('show'),2200); }
function escHtml(s){ return String(s==null?'':s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;'); }

let galleryImgs=[], galleryIndex=0;
function openLightbox(el){
  const grid = el.closest && el.closest('.img-grid');
  const srcs = grid ? Array.from(grid.querySelectorAll('img')).map(i=>i.getAttribute('src')) : [el.getAttribute('src')];
  galleryIndex = Math.max(0, srcs.indexOf(el.getAttribute('src')));
  galleryImgs = srcs; showLightbox();
  document.getElementById('lightbox').classList.add('open');
}
function showLightbox(){
  document.getElementById('lightbox-img').src = galleryImgs[galleryIndex];
  const multi = galleryImgs.length>1;
  document.getElementById('lightbox-prev').style.display = multi?'flex':'none';
  document.getElementById('lightbox-next').style.display = multi?'flex':'none';
  const c=document.getElementById('lightbox-counter');
  c.style.display = multi?'block':'none'; c.textContent=(galleryIndex+1)+' / '+galleryImgs.length;
}
function lightboxNav(d,e){ if(e)e.stopPropagation(); if(!galleryImgs.length)return; galleryIndex=(galleryIndex+d+galleryImgs.length)%galleryImgs.length; showLightbox(); }
function closeLightbox(){ document.getElementById('lightbox').classList.remove('open'); }
document.addEventListener('keydown',e=>{ if(!document.getElementById('lightbox').classList.contains('open'))return; if(e.key==='Escape')closeLightbox(); if(e.key==='ArrowLeft')lightboxNav(-1); if(e.key==='ArrowRight')lightboxNav(1); });

function clearSearch(){ const i=document.getElementById('searchInput'); i.value=''; render(); i.focus(); }

let openSet = new Set();
function toggleCard(id){ if(openSet.has(id))openSet.delete(id); else openSet.add(id); render(); }
function expandAll(on){ openSet = on ? new Set(TESTS.map(t=>t.id)) : new Set(); render(); }

function mediaHtml(t){
  let html='';
  const imgVals = (t.images||[]).map(v=>String(v||'').trim()).filter(Boolean);
  const vidName = t.video||'';
  if(imgVals.length){
    html += '<div class="tb-section"><div class="tb-title">Captures écran</div><div class="img-grid">';
    imgVals.forEach(v => {
      if(isHttp(v)){
        html += '<img loading="lazy" src="'+escHtml(v)+'" alt="" onclick="openLightbox(this)" onerror="imgErr(this)">';
      } else {
        const f = encodeURI(localName(v));   // nom corrigé ; le dossier est tenté via data-b dans imgErr
        html += '<img loading="lazy" src="'+escHtml(MEDIA_BASES[0]+f)+'" data-file="'+escHtml(f)+'" data-b="0" alt="" onclick="openLightbox(this)" onerror="imgErr(this)">';
      }
    });
    html += '</div></div>';
  }
  if(vidName){
    let inner='';
    const emb = isHttp(vidName) ? vimeoEmbed(vidName) : '';
    if(emb){
      // Vimeo : lecteur intégré (iframe responsive 16:9)
      inner = '<div class="video-embed"><iframe src="'+escHtml(emb)+'" frameborder="0" allow="autoplay; fullscreen; picture-in-picture" allowfullscreen title="'+escHtml(t.name)+'"></iframe></div>';
    } else {
      const vsrc = resolveMedia(vidName);
      if(isVideo(vsrc)){
        inner = '<div class="video-container"><video controls preload="metadata" src="'+escHtml(vsrc)+'" onerror="this.parentNode.parentNode.style.display=&#39;none&#39;"></video></div>';
      } else if(vsrc){
        // URL/fichier non vidéo et non Vimeo : tenté en image
        inner = '<div class="img-grid"><img loading="lazy" src="'+escHtml(vsrc)+'" alt="" onclick="openLightbox(this)" onerror="this.parentNode.parentNode.style.display=&#39;none&#39;"></div>';
      }
    }
    if(inner) html += '<div class="tb-section"><div class="tb-title">Vidéo</div>'+inner+'</div>';
  }
  return html;
}
function msgHtml(infos){
  if(!infos||!infos.length) return '';
  let out='<div class="tb-section"><div class="tb-title">Consignes opérateur / messages affichés</div><div class="msg-list">';
  infos.forEach(line=>{
    const pass = /(test r[ée]ussi|test termin[ée]|passed|checking passed)/i.test(line);
    out += '<div class="msg-item'+(pass?' pass':'')+'"><span class="msg-ico">'+(pass?'✔':'▸')+'</span><span>'+escHtml(line)+'</span></div>';
  });
  out+='</div></div>';
  return out;
}
function render(){
  const q = (document.getElementById('searchInput').value||'').trim().toLowerCase();
  document.getElementById('clearBtn').style.display = q?'block':'none';
  const list = q ? TESTS.filter(t => (t.name+' '+t.desc+' '+(t.effectue||'')+' '+(t.infos||[]).join(' ')).toLowerCase().includes(q)) : TESTS;
  const root = document.getElementById('results');
  if(!list.length){
    root.innerHTML = '<div class="no-results"><div class="icon">&#128269;</div><p>Aucun test ne correspond &agrave; &laquo; '+escHtml(q)+' &raquo;.</p></div>';
  } else {
    root.innerHTML = list.map(t=>{
      const idx = TESTS.indexOf(t)+1;
      const isOpen = openSet.has(t.id);
      const isDone = doneSet.has(t.id);
      const isNa   = naSet.has(t.id);
      const nImg = (t.images||[]).length;
      const hasVid = !!t.video;
      let badges='';
      if(nImg) badges += '<span class="mini-badge img">&#128247; '+nImg+'</span>';
      if(hasVid) badges += '<span class="mini-badge vid">&#9654; vid&eacute;o</span>';
      if(isDone) badges += '<span class="mini-badge" style="background:var(--green-bg);color:var(--green)">&#10003;</span>';
      if(isNa) badges += '<span class="mini-badge na-badge" style="background:var(--orange);color:#fff">N/C</span>';
      let body='';
      body += msgHtml(t.infos);
      if(t.effectue) body += '<div class="tb-section"><div class="tb-title">R&eacute;sultat attendu / test effectu&eacute;</div><div class="result-box">'+escHtml(t.effectue)+'</div></div>';
      body += mediaHtml(t);
      if(!(t.infos||[]).length && !t.effectue && !nImg && !hasVid) body += '<div class="tb-section" style="color:var(--muted);font-size:.85rem">Aucune ressource renseign&eacute;e pour ce test dans l&#39;Excel.</div>';
      body += '<div class="done-row">'
        + '<label><input type="checkbox" '+(isDone?'checked':'')+' onchange="toggleDone(&#39;'+t.id+'&#39;,this.checked)"> Test effectu&eacute;</label>'
        + '<label class="na-label"><input type="checkbox" '+(isNa?'checked':'')+' onchange="toggleNa(&#39;'+t.id+'&#39;,this.checked)"> Non concern&eacute;</label>'
        + '</div>';
      return '<div class="test-card'+(isOpen?' open':'')+((isDone||isNa)?' done':'')+(isNa&&!isDone?' na':'')+'" id="card-'+t.id+'">'
        + '<div class="test-header" onclick="toggleCard(&#39;'+t.id+'&#39;)">'
        +   '<div class="test-num">'+idx+'</div>'
        +   '<div class="test-titles"><div class="test-name">'+escHtml(t.name)+'</div><div class="test-desc">'+escHtml(t.desc)+'</div></div>'
        +   '<div class="test-badges">'+badges+'</div>'
        +   '<svg class="test-arrow" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.4" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/></svg>'
        + '</div>'
        + '<div class="test-body">'+body+'</div>'
        + '</div>';
    }).join('');
  }
  const treated = new Set([...doneSet, ...naSet]);
  document.getElementById('doneCount').textContent = treated.size;
  document.getElementById('totalCount').textContent = TESTS.length;
  const pct = TESTS.length ? Math.round(treated.size/TESTS.length*100) : 0;
  document.getElementById('progFill').style.width = pct+'%';
}

function parseSheet(rows){
  const out=[];
  rows.forEach(r=>{
    const name=(r[0]||'').toString().trim();
    if(!name) return;
    if(name.toLowerCase()==='bit test single') return;
    if((r[1]||'').toString().trim().toLowerCase()==='bit test single') return;
    const infos=(r[2]||'').toString().split('\n').map(s=>s.trim()).filter(Boolean);
    const images=[r[3],r[4]].flatMap(v=>(v||'').toString().split(/\s*&\s*/)).map(s=>s.trim()).filter(Boolean);
    out.push({ id:slug(name), name:name, desc:(r[1]||'').toString().trim(),
      infos:infos, images:images, video:(r[5]||'').toString().trim(), effectue:(r[6]||'').toString().trim() });
  });
  return out;
}
async function fetchExcelBuffer(){
  let lastErr=null;
  for(const url of EXCEL_CANDIDATES){
    try{
      const res = await fetch(url);
      if(res.ok) return await res.arrayBuffer();
      lastErr = new Error('HTTP '+res.status);
    }catch(e){ lastErr = e; }
  }
  throw lastErr || new Error('Excel introuvable');
}
async function loadExcel(){
  const banner=document.getElementById('srcBanner'), txt=document.getElementById('srcText');
  try{
    const buf = await fetchExcelBuffer();
    const wb = XLSX.read(buf,{type:'array'});
    const ws = wb.Sheets[SHEET_NAME] || wb.Sheets[wb.SheetNames[0]];
    const rows = XLSX.utils.sheet_to_json(ws,{header:1,defval:''});
    const parsed = parseSheet(rows);
    if(parsed.length){ TESTS = parsed; txt.textContent = TESTS.length+' tests chargés depuis BIT-Test.xlsx (mise à jour automatique).'; }
    else { txt.textContent = TESTS.length+' tests (instantané intégré).'; }
  }catch(err){
    banner.classList.add('warn');
    txt.textContent = TESTS.length+' tests (instantané intégré — Excel non lu en direct : '+err.message+').';
  }
  render();
}
document.addEventListener('DOMContentLoaded', function(){ loadFields(); loadExcel(); });
</script>
</body>
</html>