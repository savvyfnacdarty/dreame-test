<!DOCTYPE html>
<html lang="fr" data-theme="light">
<head>
<script src="../auth-guard.js"></script>
<meta charset="UTF-8"/>
<meta name="viewport" content="width=device-width,initial-scale=1.0"/>
<title>Bulletin Service — SAV DREAME · Fnac Darty</title>
<link rel="icon" type="image/svg+xml" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90' font-family='Arial Black,Arial,sans-serif' font-weight='900'><tspan fill='%23F5A623'>F</tspan><tspan fill='%23E62E2E'>D</tspan></text></svg>"/>
<link rel="stylesheet" href="assets/shared.css"/>
<!-- Librairies d'extraction de texte (aperçu traductible) :
     JSZip = lecture du .pptx · pdf.js = lecture du .pdf. Chargées depuis CDN. -->
<script src="https://cdn.jsdelivr.net/npm/jszip@3.10.1/dist/jszip.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/pdfjs-dist@3.11.174/build/pdf.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.18.5/xlsx.full.min.js"></script>
<style>
/* ══════════════════════════════════════════════════════════════
   PAGE — BULLETIN SERVICE
   (réutilise les tokens de assets/shared.css : --fd-red, --surface…)
══════════════════════════════════════════════════════════════ */

/* ── Barre de recherche ── */
.bs-search-wrapper { position:relative; margin-bottom:16px; }
.bs-search-input {
  width:100%; height:54px;
  background:var(--surface); border:2px solid var(--border); border-radius:var(--r-md);
  padding:0 52px 0 18px;
  font-family:var(--font-ui); font-size:15px; font-weight:500; color:var(--text);
  box-shadow:var(--shadow-sm); transition:all var(--tr);
}
.bs-search-input:focus { outline:none; border-color:var(--fd-red); box-shadow:0 0 0 4px var(--accent-glow); }
.bs-search-icon { position:absolute; right:16px; top:50%; transform:translateY(-50%); color:var(--muted); pointer-events:none; }

/* ── Filtres rapides (chips) ── */
.bs-filters { display:flex; flex-wrap:wrap; gap:8px; margin-bottom:18px; }
.bs-chip {
  display:inline-flex; align-items:center; gap:6px;
  padding:7px 14px; border-radius:999px;
  border:1.5px solid var(--border); background:var(--surface);
  color:var(--text-2); font-size:13px; font-weight:600;
  transition:all var(--tr); cursor:pointer; user-select:none;
}
.bs-chip:hover { border-color:var(--border-strong); color:var(--text); }
.bs-chip.active {
  background:var(--fd-red); border-color:var(--fd-red); color:#fff;
  box-shadow:0 2px 8px rgba(229,46,46,0.25);
}

/* ── Compteur de résultats ── */
.bs-count { font-size:13px; color:var(--muted); font-weight:600; margin-bottom:14px; }
.bs-count strong { color:var(--text); }

/* ── Grille de cartes ── */
.bs-grid { display:grid; grid-template-columns:repeat(auto-fill,minmax(340px,1fr)); gap:16px; }
.bs-card {
  display:flex; flex-direction:column;
  background:var(--surface); border:1.5px solid var(--border); border-radius:var(--r-lg);
  padding:18px; box-shadow:var(--shadow-sm); transition:all var(--tr);
}
.bs-card:hover { border-color:var(--fd-red); box-shadow:var(--shadow-md); transform:translateY(-2px); }
.bs-card-top { display:flex; align-items:flex-start; justify-content:space-between; gap:10px; margin-bottom:10px; }
.bs-card-titles { min-width:0; }
.bs-card-title { font-family:var(--font-cond); font-size:18px; font-weight:700; color:var(--text); line-height:1.25; word-break:break-word; }
.bs-card-title-fr { font-size:13px; font-weight:600; line-height:1.3; margin-top:3px; color:#2563EB; word-break:break-word; }
.bs-card-title-fr.pending { color:var(--muted); font-style:italic; font-weight:500; }
[data-theme="dark"] .bs-card-title-fr { color:#60A5FA; }

/* ── Badges type de fichier ── */
.bs-badge {
  flex-shrink:0; display:inline-flex; align-items:center; gap:5px;
  padding:3px 9px; border-radius:var(--r-sm);
  font-size:10px; font-weight:700; font-family:var(--font-mono);
  text-transform:uppercase; letter-spacing:.4px; white-space:nowrap;
}
.bs-badge.ppt { background:#FCE9E2; color:#C43E00; }
.bs-badge.pdf { background:#FBE0E0; color:#C20A0A; }
[data-theme="dark"] .bs-badge.ppt { background:#4A2410; color:#FFB07A; }
[data-theme="dark"] .bs-badge.pdf { background:#4A1414; color:#FF9A9A; }

/* ── Tags modèle / code erreur ── */
.bs-tags { display:flex; flex-wrap:wrap; gap:6px; margin-bottom:12px; }
.bs-tag {
  font-size:11px; font-weight:600; font-family:var(--font-mono);
  padding:2px 8px; border-radius:var(--r-sm);
  background:var(--surface-3); color:var(--text-2);
}
.bs-tag.err { background:var(--accent-glow); color:var(--fd-red); }

/* ── Métadonnées de la carte ── */
.bs-meta { font-size:12px; color:var(--muted); line-height:1.7; margin-bottom:14px; }
.bs-meta-row { display:flex; gap:8px; }
.bs-meta-row span:first-child { flex-shrink:0; color:var(--muted-2); min-width:78px; }
.bs-meta-row span:last-child { color:var(--text-2); word-break:break-word; }
.bs-path { font-family:var(--font-mono); font-size:11px; }

/* ── Actions de la carte ── */
.bs-actions { display:flex; gap:8px; margin-top:auto; flex-wrap:wrap; }
.bs-btn {
  display:inline-flex; align-items:center; gap:6px;
  padding:9px 14px; border-radius:var(--r-md);
  font-size:13px; font-weight:700; border:1.5px solid transparent;
  transition:all var(--tr); cursor:pointer; text-decoration:none;
}
.bs-btn-open { background:var(--fd-red); color:#fff; border-color:var(--fd-red); }
.bs-btn-open:hover { background:#c41e1e; border-color:#c41e1e; box-shadow:var(--shadow-md); }
.bs-btn-tr { background:var(--surface); color:var(--text-2); border-color:var(--border); }
.bs-btn-tr:hover { border-color:var(--border-strong); color:var(--text); background:var(--surface-2); }

/* ── Aucun résultat ── */
.bs-no-result {
  display:none; padding:28px; text-align:center;
  background:var(--surface); border:2px dashed var(--border-strong);
  border-radius:var(--r-lg); color:var(--text-2);
}
.bs-no-result.active { display:block; }
.bs-no-result strong { color:var(--fd-red); }

/* ── Section / bloc générique ── */
.bs-section { margin-top:34px; }
.bs-section-head { display:flex; align-items:center; gap:10px; margin-bottom:6px; }
.bs-section-title { font-family:var(--font-cond); font-size:24px; font-weight:700; color:var(--text); }
.bs-section-sub { font-size:13px; color:var(--muted); margin-bottom:16px; }

/* ── Traducteur EN → FR ── */
.bs-translator {
  background:var(--surface); border:1.5px solid var(--border); border-radius:var(--r-lg);
  padding:22px; box-shadow:var(--shadow-sm);
}
.bs-tr-grid { display:grid; grid-template-columns:1fr 1fr; gap:16px; }
.bs-tr-col { display:flex; flex-direction:column; }
.bs-tr-label {
  font-size:12px; font-weight:700; text-transform:uppercase; letter-spacing:.5px;
  color:var(--muted); margin-bottom:8px; display:flex; align-items:center; gap:6px;
}
.bs-tr-textarea, .bs-tr-output {
  width:100%; min-height:200px; resize:vertical;
  background:var(--surface-2); border:1.5px solid var(--border); border-radius:var(--r-md);
  padding:14px; font-family:var(--font-ui); font-size:14px; line-height:1.6; color:var(--text);
  transition:border-color var(--tr);
}
.bs-tr-textarea:focus { outline:none; border-color:var(--fd-red); }
.bs-tr-output { overflow:auto; white-space:pre-wrap; }
.bs-tr-output:empty::before { content:attr(data-placeholder); color:var(--muted); }
.bs-tr-actions { display:flex; gap:10px; flex-wrap:wrap; margin-top:14px; }
.bs-tr-hint {
  font-size:12px; color:var(--text-2); margin-top:14px;
  padding:10px 14px; background:var(--orange-bg); border:1px solid var(--orange-border);
  border-radius:var(--r-sm); display:flex; align-items:center; gap:8px;
}
.bs-tr-status { font-size:12px; color:var(--muted); margin-top:10px; min-height:16px; }
.bs-tr-status.warn { color:var(--orange); font-weight:600; }

/* ══════════════════════════════════════════════════════════════
   MODALE — APERÇU + TRADUCTION CÔTE À CÔTE
══════════════════════════════════════════════════════════════ */
.bs-modal { display:none; position:fixed; inset:0; z-index:1000; }
.bs-modal.open { display:block; }
.bs-modal-backdrop { position:absolute; inset:0; background:rgba(15,23,42,.55); backdrop-filter:blur(2px); }
.bs-modal-card {
  position:relative; z-index:1; display:flex; flex-direction:column;
  width:min(1200px, 94vw); height:min(86vh, 900px); margin:6vh auto 0;
  background:var(--surface); border-radius:var(--r-xl);
  box-shadow:var(--shadow-modal); overflow:hidden;
}
.bs-modal-head {
  display:flex; align-items:center; justify-content:space-between; gap:14px;
  padding:16px 22px; border-bottom:1px solid var(--rule); flex-shrink:0;
}
.bs-modal-title { font-family:var(--font-cond); font-size:20px; font-weight:700; color:var(--text); line-height:1.25; }
.bs-modal-close {
  flex-shrink:0; width:34px; height:34px; border-radius:var(--r-md);
  border:1.5px solid var(--border); background:var(--surface-2);
  color:var(--text-2); font-size:16px; line-height:1; transition:all var(--tr);
}
.bs-modal-close:hover { border-color:var(--fd-red); color:var(--fd-red); }
.bs-modal-body { display:grid; grid-template-columns:1fr 1fr; gap:0; flex:1; min-height:0; }
.bs-modal-pane { display:flex; flex-direction:column; padding:18px 22px; min-height:0; overflow:auto; }
.bs-pane-preview { border-right:1px solid var(--rule); }
.bs-pane-label {
  font-size:12px; font-weight:700; text-transform:uppercase; letter-spacing:.5px;
  color:var(--muted); margin-bottom:10px;
}
.bs-doc-card {
  flex:1; display:flex; flex-direction:column; align-items:center; justify-content:center;
  text-align:center; gap:12px; padding:28px 22px;
  border:1.5px solid var(--border); border-radius:var(--r-md);
  background:var(--surface-2);
}
.bs-doc-icon { color:var(--fd-red); }
.bs-doc-name { font-family:var(--font-cond); font-size:19px; font-weight:700; color:var(--text); line-height:1.3; word-break:break-word; }
.bs-doc-msg { font-size:12px; color:var(--text-2); line-height:1.6; max-width:380px; margin:4px 0 6px; }
.bs-preview-actions { display:flex; gap:8px; flex-wrap:wrap; justify-content:center; }

/* ── Aperçu slide par slide + bascule de langue ── */
.bs-pane-head { display:flex; align-items:center; justify-content:space-between; gap:10px; margin-bottom:10px; }
.bs-lang-toggle { display:inline-flex; border:1.5px solid var(--border); border-radius:999px; overflow:hidden; flex-shrink:0; }
.bs-lang-btn { padding:5px 14px; font-size:12px; font-weight:700; background:var(--surface); color:var(--text-2); border:0; cursor:pointer; transition:all var(--tr); }
.bs-lang-btn.active { background:var(--fd-red); color:#fff; }
.bs-preview-scroll { flex:1; min-height:0; overflow:auto; }
.bs-slides-bar { display:flex; align-items:center; justify-content:space-between; gap:10px; margin-bottom:12px; font-size:12px; color:var(--muted); font-weight:600; }
.bs-slide { border:1.5px solid var(--border); border-radius:var(--r-md); background:var(--surface-2); padding:14px; margin-bottom:12px; }
.bs-slide-head { font-size:11px; font-weight:700; text-transform:uppercase; letter-spacing:.5px; color:var(--muted); margin-bottom:8px; }
.bs-slide-text { font-size:13px; line-height:1.6; color:var(--text); white-space:pre-wrap; word-break:break-word; }
.bs-slide-text.pending { color:var(--muted); font-style:italic; }
.bs-slide-media { display:flex; flex-wrap:wrap; gap:8px; margin-top:10px; }
.bs-slide-media img { max-width:100%; max-height:260px; object-fit:contain; border-radius:var(--r-sm); border:1px solid var(--border); background:#fff; }
.bs-slide-media video { width:100%; max-height:340px; border-radius:var(--r-sm); border:1px solid var(--border); background:#000; }
.bs-import-row { display:flex; align-items:center; gap:10px; flex-wrap:wrap; margin-bottom:10px; }
.bs-import-hint { font-size:12px; color:var(--muted); }
.bs-modal-tr-actions { display:flex; gap:8px; flex-wrap:wrap; margin:12px 0; }
#bsModalSrc { min-height:120px; }
#bsModalOut { flex:0 0 auto; min-height:120px; }

/* ── Responsive (tablette / mobile) ── */
@media (max-width:880px) {
  .bs-tr-grid { grid-template-columns:1fr; }
  .bs-modal-body { grid-template-columns:1fr; overflow:auto; }
  .bs-pane-preview { border-right:none; border-bottom:1px solid var(--rule); }
  .bs-iframe-wrap { min-height:340px; }
}
@media (max-width:560px) {
  .bs-grid { grid-template-columns:1fr; }
}
</style>
<!-- ===== Compteur de consultations (GoatCounter) =====
     Tableau de bord prive : https://hub-drive-fnac.goatcounter.com  -->
<script data-goatcounter="https://hub-drive-fnac.goatcounter.com/count"
        async src="//gc.zgo.at/count.js"></script>
<!-- ===== Fin compteur ===== -->
</head>
<body>

<!-- ══════════════════════════════════════════════════════════════
     HEADER + NAVIGATION
     (identique aux autres pages ; onglet « Bulletin Service » marqué .active)
══════════════════════════════════════════════════════════════ -->
<style id="fdhub-css">
.fdtop{background:#D4151B;padding:8px 20px;display:flex;align-items:center;gap:14px;position:sticky;top:0;z-index:9999;box-shadow:0 2px 6px rgba(0,0,0,.15);font-family:'Segoe UI',Arial,sans-serif;}
.fdtop .fdtop-home{display:flex;align-items:center;gap:11px;text-decoration:none;flex-shrink:0;}
.fdtop .fdtop-home img{height:28px;background:#fff;padding:4px 8px;border-radius:5px;display:block;}
.fdtop .fdtop-txt{color:#fff;font-weight:700;font-size:13px;letter-spacing:.3px;}
.fdtop .fdtop-right{margin-left:auto;display:flex;align-items:center;gap:10px;}
.fdband{background:linear-gradient(120deg,#1B4E97 0%,#2669C2 60%,#4A8AD4 100%);padding:22px 20px 18px;text-align:center;font-family:'Segoe UI',Arial,sans-serif;}
.fdband .fdband-logo{height:44px;background:#fff;padding:7px 14px;border-radius:9px;box-shadow:0 4px 14px rgba(0,0,0,.2);display:block;margin:0 auto 14px;}
.fdband nav{display:flex;gap:8px;justify-content:center;flex-wrap:wrap;}
.fdband nav a{color:#fff;text-decoration:none;font-size:.86rem;font-weight:600;padding:8px 18px;border-radius:8px;background:rgba(255,255,255,.14);border:1.5px solid rgba(255,255,255,.45);transition:.15s;}
.fdband nav a:hover{background:rgba(255,255,255,.28);}
.fdband nav a.active{background:#fff;color:#1B4E97;border-color:#fff;}
</style>
<div class="fdtop">
  <a class="fdtop-home" href="../index.html" title="Retour au HUB Drive Constructeurs">
    <img src="assets/FNAC DARTY.png" alt="Fnac Darty"><span class="fdtop-txt">&larr; HUB Drive Constructeurs</span>
  </a>
  <div class="fdtop-right"><button class="theme-toggle" id="themeToggle" onclick="toggleTheme()" title="Mode nuit / jour">&#9728;</button></div>
</div>
<div class="fdband">
  <img class="fdband-logo" src="assets/DREAME.png" alt="Dreame" onerror="this.style.display='none'">
  <nav>
    <a href="dreame.html">Recherche</a>
    <a href="lecteur_bom.html">Lecteur BOM</a>
    <a href="robot_laveur.html" class="active">🤖 Robot laveur</a>
    <a href="aspirateur_balai_laveur.html">🧹 Aspirateur balai laveur</a>
  </nav>
</div>

<!-- ══════════════════════════════════════════════════════════════
     CONTENU
══════════════════════════════════════════════════════════════ -->
<main class="main-wrap">

  <!-- ── Bandeau de synchronisation Excel ── -->
  <div class="bs-sync-bar" style="display:flex;align-items:center;gap:12px;flex-wrap:wrap;margin:0 0 14px;padding:10px 14px;border:1px solid var(--fd-border,#e3e3e3);border-radius:10px;background:var(--fd-card,#fff);font-size:13px;">
    <span id="bsSyncDot" style="width:10px;height:10px;border-radius:50%;background:#c98a00;flex:none;"></span>
    <span id="bsSyncTxt" style="flex:1;min-width:200px;">Initialisation…</span>
    <label style="cursor:pointer;display:inline-flex;align-items:center;gap:6px;padding:6px 12px;border:1px solid #E62E2E;color:#E62E2E;border-radius:8px;font-weight:600;white-space:nowrap;">
      ↥ Charger l\'export
      <input id="bsXlsxPick" type="file" accept=".xlsx,.xls" hidden>
    </label>
  </div>

  <!-- ── 1. Recherche ── -->
  <div class="bs-search-wrapper">
    <input type="text" id="bsSearch" class="bs-search-input" autocomplete="off"
      placeholder="Rechercher un Bulletin Service : modèle (X40, H15…), code erreur (R2579…), problème (water leak, motherboard…)"/>
    <div class="bs-search-icon">
      <svg width="20" height="20" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
    </div>
  </div>

  <!-- ── Filtres rapides ── -->
  <div class="bs-filters" id="bsFilters"></div>

  <!-- ── Compteur ── -->
  <div class="bs-count" id="bsCount"></div>

  <!-- ── Résultats ── -->
  <div class="bs-grid" id="bsGrid"></div>

  <!-- ── Aucun résultat ── -->
  <div class="bs-no-result" id="bsNoResult">
    Aucun Bulletin Service ne correspond à <strong id="bsNoResultTerm"></strong>.<br/>
    Essayez un autre modèle, un code erreur, ou réinitialisez les filtres.
  </div>

  <!-- ── 3 & 4. Traducteur EN → FR (autonome) ── -->
  <section class="bs-section" id="bsTranslatorSection">
    <div class="bs-section-head">
      <svg width="22" height="22" fill="none" stroke="var(--fd-red)" stroke-width="2.2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M3 5h12M9 3v2m1.048 9.5A18.022 18.022 0 016.412 9m6.088 9h7M11 21l5-10 5 10M12.751 5C11.783 10.77 8.07 15.61 3 18.129"/></svg>
      <div class="bs-section-title">Traducteur anglais → français</div>
    </div>
    <div class="bs-section-sub">Collez ici le texte extrait du Bulletin Service anglais pour obtenir une version française exploitable.</div>

    <div class="bs-translator">
      <div class="bs-tr-grid">
        <div class="bs-tr-col">
          <div class="bs-tr-label">
            <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M3 5h12M9 3v2m1 9A18 18 0 016 9"/></svg>
            Texte anglais (source)
          </div>
          <textarea id="bsTrInput" class="bs-tr-textarea" placeholder="Paste the English text extracted from the PowerPoint or PDF here…"></textarea>
        </div>
        <div class="bs-tr-col">
          <div class="bs-tr-label">
            <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 21l5-10 5 10M14 18h7"/></svg>
            Traduction française
          </div>
          <div id="bsTrOutput" class="bs-tr-output" data-placeholder="La traduction française s'affichera ici…"></div>
        </div>
      </div>

      <div class="bs-tr-actions">
        <button class="bs-btn bs-btn-open" onclick="bsRunTranslation()">
          <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14m-7-7l7 7-7 7"/></svg>
          Traduire en français
        </button>
        <button class="bs-btn bs-btn-tr" onclick="bsCopyTranslation()">Copier la traduction</button>
        <button class="bs-btn bs-btn-tr" onclick="bsClearTranslation()">Effacer</button>
      </div>

      <div class="bs-tr-status" id="bsTrStatus"></div>

      <div class="bs-tr-hint">
        <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.2" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><path stroke-linecap="round" stroke-linejoin="round" d="M12 16v-4m0-4h.01"/></svg>
        Traduction assurée par un service gratuit (Google Translate, sans clé API ; repli automatique sur MyMemory). Pour un service interne (DeepL, Azure, proxy Fnac…), voir <code>bsTranslateCustom()</code> dans le code.
      </div>
    </div>
  </section>

</main>

<!-- ══════════════════════════════════════════════════════════════
     MODALE — APERÇU TRADUCTIBLE
     Gauche : aperçu SharePoint (iframe) · Droite : texte extrait + traduction
══════════════════════════════════════════════════════════════ -->
<div class="bs-modal" id="bsModal" aria-hidden="true">
  <div class="bs-modal-backdrop" onclick="bsClosePreview()"></div>
  <div class="bs-modal-card" role="dialog" aria-modal="true" aria-labelledby="bsModalTitle">
    <div class="bs-modal-head">
      <div class="bs-modal-title" id="bsModalTitle">Aperçu</div>
      <button class="bs-modal-close" onclick="bsClosePreview()" aria-label="Fermer">✕</button>
    </div>
    <div class="bs-modal-body">

      <!-- ── Gauche : aperçu traductible généré depuis le fichier importé ── -->
      <div class="bs-modal-pane bs-pane-preview">
        <!-- input fichier partagé (déclenché par les labels for="bsFileImport") -->
        <input type="file" id="bsFileImport" accept=".pptx,.pdf,.txt" hidden/>
        <div class="bs-pane-head">
          <div class="bs-pane-label">Aperçu traductible</div>
          <div class="bs-lang-toggle" id="bsLangToggle" style="display:none;">
            <button class="bs-lang-btn active" id="bsLangEn" type="button" onclick="bsSetPreviewLang('en')">Anglais</button>
            <button class="bs-lang-btn" id="bsLangFr" type="button" onclick="bsSetPreviewLang('fr')">Français</button>
          </div>
        </div>

        <div class="bs-preview-scroll" id="bsPreviewScroll">

          <!-- État par défaut : carte document -->
          <div class="bs-doc-card" id="bsDocCard">
            <div class="bs-doc-icon" id="bsDocIcon"></div>
            <div class="bs-doc-name" id="bsDocName"></div>
            <span class="bs-badge" id="bsDocBadge"></span>
            <p class="bs-doc-msg">
              L'aperçu visuel intégré n'est pas disponible ici.
              <strong>Importez le fichier</strong> (.pptx / .pdf) pour générer ici un aperçu <strong>slide par slide, traductible d'un clic</strong>. Vous pouvez aussi ouvrir ou télécharger le document.
            </p>
            <div class="bs-preview-actions">
              <label class="bs-btn bs-btn-open" for="bsFileImport" style="cursor:pointer;">
                <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 16V8m0 0l-3 3m3-3l3 3M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1"/></svg>
                Importer le fichier
              </label>
            </div>
            <div class="bs-preview-actions">
              <a class="bs-btn bs-btn-tr" id="bsOpenExternal" target="_blank" rel="noopener" href="#">
                <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/></svg>
                Ouvrir
              </a>
              <a class="bs-btn bs-btn-tr" id="bsDownloadFile" href="#" download>
                <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"/></svg>
                Télécharger
              </a>
            </div>
          </div>

          <!-- État chargé : aperçu slide par slide -->
          <div id="bsSlidesWrap" style="display:none;">
            <div class="bs-slides-bar">
              <span id="bsSlidesInfo"></span>
              <label class="bs-btn bs-btn-tr" for="bsFileImport" style="cursor:pointer;padding:6px 12px;">Réimporter</label>
            </div>
            <div id="bsSlides"></div>
          </div>

        </div>
      </div>

      <!-- ── Droite : texte + traduction ── -->
      <div class="bs-modal-pane bs-pane-tr">
        <div class="bs-pane-label">Texte &amp; traduction française</div>

        <div class="bs-import-row">
          <span class="bs-import-hint" id="bsImportHint">Le texte du fichier importé (à gauche) apparaît ci-dessous. Vous pouvez aussi le coller manuellement, puis traduire l'ensemble.</span>
        </div>

        <textarea id="bsModalSrc" class="bs-tr-textarea" placeholder="Texte anglais — importez un fichier à gauche, ou collez le texte ici…"></textarea>

        <div class="bs-modal-tr-actions">
          <button class="bs-btn bs-btn-open" onclick="bsModalTranslate()">
            <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14m-7-7l7 7-7 7"/></svg>
            Traduire en français
          </button>
          <button class="bs-btn bs-btn-tr" onclick="bsModalCopy()">Copier</button>
          <button class="bs-btn bs-btn-tr" onclick="bsModalClear()">Effacer</button>
        </div>

        <div class="bs-pane-label" style="margin-top:4px;">Traduction</div>
        <div id="bsModalOut" class="bs-tr-output" data-placeholder="La traduction française s'affichera ici…"></div>
        <div class="bs-tr-status" id="bsModalStatus"></div>
      </div>

    </div>
  </div>
</div>

<div id="toast"></div>

<script>
/* ══════════════════════════════════════════════════════════════
   DARK MODE  (identique aux autres pages du portail)
══════════════════════════════════════════════════════════════ */
const LS_THEME = 'fd_sav_theme';
function toggleTheme() {
  const next = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
  applyTheme(next);
  try { localStorage.setItem(LS_THEME, next); } catch(e){}
}
function applyTheme(t) {
  document.documentElement.dataset.theme = t;
  document.getElementById('themeToggle').textContent = t === 'dark' ? '☾' : '☀';
}
(function(){ try { const s = localStorage.getItem(LS_THEME); if (s) applyTheme(s); } catch(e){} })();

/* ══════════════════════════════════════════════════════════════
   TOAST
══════════════════════════════════════════════════════════════ */
let _toastTimer;
function showToast(msg) {
  const t = document.getElementById('toast');
  t.textContent = msg; t.classList.add('show');
  clearTimeout(_toastTimer);
  _toastTimer = setTimeout(() => t.classList.remove('show'), 2200);
}

/* ══════════════════════════════════════════════════════════════
   5. DONNÉES — BULLETINS SERVICE
   Structure prête pour l'import Excel (20260625_Bulletin service.xlsx).
   Colonnes : Nom / Modifié / Modifié par / Type d'élément / Chemin d'accès.
   Lignes issues directement du fichier Excel (70 bulletins).
══════════════════════════════════════════════════════════════ */
let bulletinServiceData = [];
const EXCEL_FILE    = "Export_GEM_TV_Drive.xlsx";
const TARGET_FOLDER = "After-sales information/TIPS/Technical notification2";

function bsSetSync(state, msg) {
  const dot = document.getElementById('bsSyncDot');
  const txt = document.getElementById('bsSyncTxt');
  if (dot) dot.style.background = state === 'ok' ? '#1d7145' : state === 'err' ? '#E62E2E' : '#c98a00';
  if (txt) txt.innerHTML = msg;
}

/* Transforme un classeur XLSX (ArrayBuffer) en liste filtree sur TARGET_FOLDER. */
function bsParseWorkbook(buf) {
  const wb  = XLSX.read(buf, { type:'array' });
  const ws  = wb.Sheets[wb.SheetNames[0]];              // 1re feuille = « Export »
  const aoa = XLSX.utils.sheet_to_json(ws, { header:1, defval:'' });
  if (!aoa.length) throw new Error('Feuille vide.');
  const head  = aoa[0].map(h => String(h).trim().toLowerCase());
  const iPath = head.indexOf('chemin'), iName = head.indexOf('nom'),
        iType = head.indexOf('type'),   iLink = head.indexOf('lien');
  const out = [];
  for (let r = 1; r < aoa.length; r++) {
    const row  = aoa[r] || [];
    const path = String(row[iPath] || '').trim();
    const type = String(row[iType] || '').trim();
    if (path === TARGET_FOLDER && /fichier/i.test(type)) {
      out.push({
        nom:         String(row[iName] || '').trim(),
        cheminAcces: path,
        typeElement: type,
        lien:        String(row[iLink] || '').trim()
      });
    }
  }
  return out;
}

function bsApplyWorkbook(buf, lastMod) {
  const rows = bsParseWorkbook(buf);
  if (!rows.length) throw new Error('Aucun fichier dans « ' + TARGET_FOLDER + ' ».');
  bulletinServiceData = rows;
  bsSetSync('ok', 'Synchronise avec <b>' + EXCEL_FILE + '</b> &middot; ' + rows.length + ' fichiers' + (lastMod ? ' &middot; ' + lastMod : ''));
  initBulletins();
}

async function loadBulletinExcel() {
  bsSetSync('load', 'Chargement de <b>' + EXCEL_FILE + '</b>…');
  try {
    const res = await fetch(EXCEL_FILE, { cache:'no-store' });
    if (!res.ok) throw new Error('HTTP ' + res.status);
    const buf = await res.arrayBuffer();
    let lm = res.headers.get('Last-Modified');
    if (lm) { const d = new Date(lm); if (!isNaN(d)) lm = 'maj ' + d.toLocaleDateString('fr-FR'); }
    bsApplyWorkbook(buf, lm);
  } catch (e) {
    bsSetSync('err', 'Lecture auto impossible (' + (e.message || e) + '). En local, cliquez « Charger l\'export ».');
  }
}

/* ══════════════════════════════════════════════════════════════
   NORMALISATION (tolérance casse / espaces / tirets / underscores
   / caractères spéciaux)
══════════════════════════════════════════════════════════════ */
function bsNormalize(s) {
  return String(s || '')
    .toLowerCase()
    .normalize('NFD').replace(/[̀-ͯ]/g, '')   // accents
    .replace(/[^a-z0-9]+/g, '');  // ne garde que lettres + chiffres
}

function bsFileType(nom) {
  const n = String(nom || '').toLowerCase();
  if (n.endsWith('.pdf')) return 'pdf';
  if (n.endsWith('.pptx') || n.endsWith('.ppt')) return 'ppt';
  return 'autre';
}

function bsExtractErrorCodes(nom) {
  const m = String(nom || '').match(/R\d{3,4}[A-Z]?/gi);
  return m ? [...new Set(m.map(x => x.toUpperCase()))] : [];
}

function bsExtractModels(nom) {
  const tokens = String(nom || '').match(/\b(?:X\d{2}|L\d{2}s?|Z\d{2}|H\d{2}|G\d{2}|M\d{2}|Matrix\s?10|Aqua\s?10|VIAX|A series)\b/gi);
  return tokens ? [...new Set(tokens.map(t => t.replace(/\s+/g,' ').trim()))].slice(0,4) : [];
}

function bsCleanName(nom) {
  return String(nom || '').replace(/\.(pptx?|pdf)$/i, '');
}

/* ══════════════════════════════════════════════════════════════
   2. LIENS SHAREPOINT (ouverture du document)
══════════════════════════════════════════════════════════════ */
function bsBuildOpenLink(item) {
  return item.lien || '#';   // lien direct Google Docs (colonne « Lien » de l'export)
}

/* ══════════════════════════════════════════════════════════════
   6. FILTRES RAPIDES (mots-clés cherchés dans nom + chemin normalisés)
══════════════════════════════════════════════════════════════ */
const BS_FILTERS = [
  { id:'all',     label:'Tous' },
  { id:'pdf',     label:'PDF',             type:'pdf' },
  { id:'ppt',     label:'PowerPoint',      type:'ppt' },
  { id:'dreame',  label:'Dreame',          excludeKw:['mova'] },
  { id:'mova',    label:'MOVA',            kw:['mova'] },
  { id:'robot',   label:'Robot',           kw:['robot','matrix','aqua','sidebrush','mop','obstacle','x40','x50','x30','l40','l50','l20','l10','z20','z30','z40','z60'] },
  { id:'station', label:'Station de base', kw:['basestation','station','charging','waterway','masterstation','dock'] },
  { id:'battery', label:'Batterie',        kw:['battery','batterie'] },
  { id:'calib',   label:'Calibration',     kw:['calibration','calibrate','calibrage'] },
  { id:'leak',    label:"Fuite d'eau",     kw:['leak','leakage','watershortage','nowater','wateroutput','waterflow','fluidleaking','noflow','leakswater'] },
  { id:'wheel',   label:'Roue / moteur',   kw:['wheel','motor','drivewheel','swing','shortcircuit'] },
  { id:'board',   label:'Carte mère',      kw:['motherboard','mainboard','coreboard','mcu','soc','pcba'] }
];

/* ══════════════════════════════════════════════════════════════
   ÉTAT + INITIALISATION
══════════════════════════════════════════════════════════════ */
let bsActiveFilter = 'all';
let bsIndex = [];

function initBulletins() {
  bsIndex = bulletinServiceData.map(item => ({
    ...item,
    _type:   bsFileType(item.nom),
    _errors: bsExtractErrorCodes(item.nom),
    _models: bsExtractModels(item.nom),
    _hay:    bsNormalize((item.nom||'') + ' ' + (item.cheminAcces||'') + ' ' + (item.lien||''))
  }));
  renderFilters();
  renderResults();
}

function renderFilters() {
  const box = document.getElementById('bsFilters');
  box.innerHTML = '';
  BS_FILTERS.forEach(f => {
    const chip = document.createElement('button');
    chip.className = 'bs-chip' + (f.id === bsActiveFilter ? ' active' : '');
    chip.textContent = f.label;
    chip.onclick = () => { bsActiveFilter = f.id; renderFilters(); renderResults(); };
    box.appendChild(chip);
  });
}

function bsPassFilter(item) {
  const f = BS_FILTERS.find(x => x.id === bsActiveFilter);
  if (!f || f.id === 'all') return true;
  if (f.type) return item._type === f.type;
  if (f.excludeKw) return !f.excludeKw.some(k => item._hay.includes(bsNormalize(k)));
  if (f.kw) return f.kw.some(k => item._hay.includes(bsNormalize(k)));
  return true;
}

/* ══════════════════════════════════════════════════════════════
   1 & 2. RECHERCHE + AFFICHAGE DES RÉSULTATS
══════════════════════════════════════════════════════════════ */
function renderResults() {
  const q     = document.getElementById('bsSearch').value.trim();
  const grid  = document.getElementById('bsGrid');
  const nores = document.getElementById('bsNoResult');
  const count = document.getElementById('bsCount');
  grid.innerHTML = '';

  const terms = q ? q.split(/\s+/).map(bsNormalize).filter(Boolean) : [];
  const list  = bsIndex.filter(item => bsPassFilter(item) && terms.every(t => item._hay.includes(t)));

  count.innerHTML = `<strong>${list.length}</strong> bulletin(s) sur ${bsIndex.length}`;

  if (!list.length) {
    nores.classList.add('active');
    document.getElementById('bsNoResultTerm').textContent = q || '(filtre actif)';
    return;
  }
  nores.classList.remove('active');
  list.forEach(item => grid.appendChild(bsCardEl(item)));
}

function bsCardEl(item) {
  const card = document.createElement('div');
  card.className = 'bs-card';

  const badgeClass = item._type === 'pdf' ? 'pdf' : 'ppt';
  const badgeLabel = item._type === 'pdf' ? 'PDF' : (item._type === 'ppt' ? 'PowerPoint' : 'Fichier');
  const openLink   = bsBuildOpenLink(item);
  const tags = [
    ...item._models.map(m => `<span class="bs-tag">${esc(m)}</span>`),
    ...item._errors.map(e => `<span class="bs-tag err">${esc(e)}</span>`)
  ].join('');

  card.innerHTML = `
    <div class="bs-card-top">
      <div class="bs-card-titles">
        <div class="bs-card-title">${esc(bsCleanName(item.nom))}</div>
        <div class="bs-card-title-fr pending">Traduction du titre…</div>
      </div>
      <span class="bs-badge ${badgeClass}">${badgeLabel}</span>
    </div>
    ${tags ? `<div class="bs-tags">${tags}</div>` : ''}
    <div class="bs-meta">
      <div class="bs-meta-row"><span>Type</span><span>${esc(item.typeElement||'Fichier')}</span></div>
      <div class="bs-meta-row"><span>Chemin</span><span class="bs-path">${esc(item.cheminAcces)}</span></div>
    </div>
    <div class="bs-actions">
      <button class="bs-btn bs-btn-open bs-btn-preview" type="button">
        <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M2.5 12S5.5 5 12 5s9.5 7 9.5 7-3 7-9.5 7-9.5-7-9.5-7z"/><circle cx="12" cy="12" r="3"/></svg>
        Aperçu traductible
      </button>
      <a class="bs-btn bs-btn-tr" href="${esc(openLink)}" target="_blank" rel="noopener">
        <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/></svg>
        Ouvrir
      </a>
    </div>`;

  card.querySelector('.bs-btn-preview').addEventListener('click', () => bsOpenPreview(item));

  // Traduction du titre (FR) affichée sous le titre anglais, en bleu — avec cache.
  bsQueueTitleTranslation(bsCleanName(item.nom), card.querySelector('.bs-card-title-fr'));

  return card;
}

/* ══════════════════════════════════════════════════════════════
   TRADUCTION DES TITRES (vignettes) — file d'attente + cache
   Affiche la traduction française sous le titre anglais. Le cache évite
   de retraduire à chaque frappe de recherche ; la file séquentielle
   ménage le service de traduction (pas de rafale de requêtes).
══════════════════════════════════════════════════════════════ */
const bsTitleFrCache = new Map();    // titre EN → titre FR (résultats)
const bsTitlePending = new Map();    // titre EN → [éléments à mettre à jour]
const bsTitleQueue = [];
let bsTitleBusy = false;

function bsQueueTitleTranslation(enTitle, el) {
  if (!el) return;
  if (bsTitleFrCache.has(enTitle)) {            // déjà traduit : affichage immédiat
    el.textContent = bsTitleFrCache.get(enTitle);
    el.classList.remove('pending');
    return;
  }
  if (bsTitlePending.has(enTitle)) {            // traduction déjà en cours : on s'y rattache
    bsTitlePending.get(enTitle).push(el);
    return;
  }
  bsTitlePending.set(enTitle, [el]);
  bsTitleQueue.push(enTitle);
  bsProcessTitleQueue();
}

async function bsProcessTitleQueue() {
  if (bsTitleBusy) return;
  bsTitleBusy = true;
  while (bsTitleQueue.length) {
    const enTitle = bsTitleQueue.shift();
    const els = bsTitlePending.get(enTitle) || [];
    let fr = null;
    try { fr = await translateToFrench(enTitle); bsTitleFrCache.set(enTitle, fr); }
    catch (e) { fr = null; }   // échec réseau/quota : on garde le titre anglais seul
    bsTitlePending.delete(enTitle);
    els.forEach(el => {
      if (!el.isConnected) return;
      if (fr) { el.textContent = fr; el.classList.remove('pending'); }
      else    { el.style.display = 'none'; }
    });
    await new Promise(r => setTimeout(r, 120));  // petite pause pour ménager l'API
  }
  bsTitleBusy = false;
}

function esc(s) {
  return String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
}

/* ══════════════════════════════════════════════════════════════
   3. TRADUCTEUR ANGLAIS → FRANÇAIS
   ──────────────────────────────────────────────────────────────
   ⚠ AUCUNE CLÉ API DANS LE HTML.
   Branchez votre service (DeepL, Azure, Google, ou endpoint interne)
   UNIQUEMENT dans translateToFrench(text). La clé reste côté serveur.
══════════════════════════════════════════════════════════════ */

/* Service de traduction actif. Valeurs possibles : 'google' (gratuit, sans clé,
   quota large — défaut), 'mymemory' (gratuit mais quota ~5000 mots/jour/IP)
   ou 'custom' (votre propre endpoint/proxy interne — voir bsTranslateCustom). */
const BS_TRANSLATE_PROVIDER = 'google';

/**
 * translateToFrench — traduit un texte anglais en français.
 * Découpe le texte ligne par ligne (préserve la structure des slides/pages),
 * puis traduit chaque segment via le service choisi.
 * @param {string} text  Texte source (anglais)
 * @returns {Promise<string>}  Texte traduit (français)
 */
async function translateToFrench(text) {
  const lines = String(text).split('\n');
  const out = [];
  for (const line of lines) {
    const trimmed = line.trim();
    // Lignes vides ou marqueurs « — Slide N — / — Page N — » : on garde tel quel.
    if (!trimmed || /^—\s*(Slide|Page)\b/i.test(trimmed)) { out.push(line); continue; }
    out.push(await bsTranslateLine(line));
  }
  return out.join('\n');
}

/* Traduit une ligne, en la re-découpant si elle dépasse la limite du service. */
async function bsTranslateLine(line) {
  const parts = bsChunkText(line, 450);   // MyMemory recommande ≤ 500 caractères / requête
  const res = [];
  for (const p of parts) res.push(await bsTranslateSegment(p));
  return res.join(' ');
}

/* Découpe un texte en segments ≤ max, sur les fins de phrases si possible. */
function bsChunkText(s, max) {
  if (s.length <= max) return [s];
  const out = []; let cur = '';
  for (const sent of s.split(/(?<=[.!?；;])\s+/)) {
    if ((cur + ' ' + sent).trim().length > max) {
      if (cur) out.push(cur.trim());
      // segment unique trop long : on coupe brutalement
      if (sent.length > max) { for (let i = 0; i < sent.length; i += max) out.push(sent.slice(i, i + max)); cur = ''; }
      else cur = sent;
    } else { cur = (cur ? cur + ' ' : '') + sent; }
  }
  if (cur.trim()) out.push(cur.trim());
  return out;
}

/* Aiguille vers le bon service de traduction.
   En mode 'google', bascule automatiquement sur MyMemory en cas d'échec. */
async function bsTranslateSegment(segment) {
  if (BS_TRANSLATE_PROVIDER === 'custom')   return bsTranslateCustom(segment);
  if (BS_TRANSLATE_PROVIDER === 'mymemory') return bsTranslateMyMemory(segment);
  // Défaut : Google, avec repli sur MyMemory si l'endpoint échoue.
  try { return await bsTranslateGoogle(segment); }
  catch (e) { return bsTranslateMyMemory(segment); }
}

/* ── Service par défaut : Google Translate (endpoint public gtx) ──
   Gratuit, sans clé API, CORS ouvert, pas de quota strict par IP.
   Endpoint non officiel : peut évoluer sans préavis (repli MyMemory prévu). */
async function bsTranslateGoogle(segment) {
  const url = 'https://translate.googleapis.com/translate_a/single?client=gtx&sl=en&tl=fr&dt=t&q=' +
              encodeURIComponent(segment);
  const res = await fetch(url);
  if (!res.ok) throw new Error('Google HTTP ' + res.status);
  const data = await res.json();
  // data[0] = tableau de segments ; chaque segment[0] = texte traduit.
  if (!data || !Array.isArray(data[0])) throw new Error('réponse Google vide');
  return data[0].map(seg => (seg && seg[0]) ? seg[0] : '').join('');
}

/* ── Service par défaut : MyMemory (gratuit, sans clé API, CORS ouvert) ──
   Limite indicative : ~5000 mots/jour en anonyme. Pour augmenter la limite,
   ajoutez votre e-mail : &de=adresse@domaine (aucune clé secrète requise). */
async function bsTranslateMyMemory(segment) {
  const url = 'https://api.mymemory.translated.net/get?q=' +
              encodeURIComponent(segment) + '&langpair=en|fr';
  const res = await fetch(url);
  if (!res.ok) throw new Error('MyMemory HTTP ' + res.status);
  const data = await res.json();
  const t = data && data.responseData && data.responseData.translatedText;
  if (!t) throw new Error(data && data.responseDetails ? data.responseDetails : 'réponse vide');
  return t;
}

/* ── Option : VOTRE service interne (DeepL, Azure, Google, proxy Fnac…) ──
   ⚠ AUCUNE CLÉ API DANS LE HTML : la clé doit rester côté serveur (proxy).
   Mettez BS_TRANSLATE_PROVIDER = 'custom' puis complétez l'appel ci-dessous. */
async function bsTranslateCustom(segment) {
  /* ┌──────────────────────────────────────────────────────────┐
     │  >>> CONNECTEUR DE TRADUCTION INTERNE À BRANCHER ICI <<<  │
     │  const res = await fetch('/api/translate', {             │
     │    method:'POST', headers:{'Content-Type':'application/json'},│
     │    body: JSON.stringify({ text: segment, source:'en', target:'fr' })│
     │  });                                                      │
     │  if (!res.ok) throw new Error('translate API error');    │
     │  return (await res.json()).translation;   // texte FR    │
     └──────────────────────────────────────────────────────────┘ */
  throw new Error('Connecteur interne non configuré (voir bsTranslateCustom).');
}

/* Le traducteur est opérationnel (service gratuit branché). */
const BS_TRANSLATE_CONNECTED = true;

async function bsRunTranslation() {
  const input  = document.getElementById('bsTrInput').value.trim();
  const output = document.getElementById('bsTrOutput');
  const status = document.getElementById('bsTrStatus');
  if (!input) {
    status.textContent = 'Saisissez ou collez d\'abord un texte anglais.';
    status.className = 'bs-tr-status warn';
    output.textContent = '';
    return;
  }
  status.textContent = 'Traduction en cours…';
  status.className = 'bs-tr-status';
  try {
    output.textContent = await translateToFrench(input);
    status.textContent = BS_TRANSLATE_CONNECTED
      ? 'Traduction terminée.'
      : 'Mode démonstration : connecteur de traduction non branché (voir translateToFrench()).';
    status.className = BS_TRANSLATE_CONNECTED ? 'bs-tr-status' : 'bs-tr-status warn';
  } catch (e) {
    output.textContent = '';
    status.textContent = 'Erreur de traduction : ' + e.message;
    status.className = 'bs-tr-status warn';
  }
}

function bsCopyTranslation() {
  const txt = document.getElementById('bsTrOutput').textContent;
  if (!txt) { showToast('Rien à copier.'); return; }
  navigator.clipboard.writeText(txt).then(() => showToast('Traduction copiée ✓'))
    .catch(() => showToast('Copie impossible.'));
}

function bsClearTranslation() {
  document.getElementById('bsTrInput').value = '';
  document.getElementById('bsTrOutput').textContent = '';
  document.getElementById('bsTrStatus').textContent = '';
  document.getElementById('bsTrInput').focus();
}

/* ══════════════════════════════════════════════════════════════
   APERÇU TRADUCTIBLE (MODALE)
   Gauche : aperçu SharePoint (iframe Office Online).
   Droite : texte du document + traduction française.
   En local (file://), le contenu d'un fichier SharePoint distant ne peut
   pas être lu par le navigateur (CORS) : on propose donc l'import direct
   du .pptx / .pdf pour en extraire le texte (hors-ligne) — ou le copier-coller.
══════════════════════════════════════════════════════════════ */
if (window.pdfjsLib) {
  pdfjsLib.GlobalWorkerOptions.workerSrc =
    'https://cdn.jsdelivr.net/npm/pdfjs-dist@3.11.174/build/pdf.worker.min.js';
}

function bsBuildEmbedUrl(item) {   // conserve (non utilise) : renvoie le lien Google Docs
  return item.lien || '#';
}

/* Lien de téléchargement forcé : transforme le lien Google Docs en URL d'export
   (Content-Disposition: attachment) pour déclencher un vrai enregistrement. */
function bsBuildDownloadLink(item) {
  const url = item.lien || '';
  let m;
  if ((m = url.match(/\/presentation\/d\/([^/]+)/))) return `https://docs.google.com/presentation/d/${m[1]}/export/pptx`;
  if ((m = url.match(/\/document\/d\/([^/]+)/)))      return `https://docs.google.com/document/d/${m[1]}/export?format=docx`;
  if ((m = url.match(/\/spreadsheets\/d\/([^/]+)/)))  return `https://docs.google.com/spreadsheets/d/${m[1]}/export?format=xlsx`;
  if ((m = url.match(/\/file\/d\/([^/]+)/)))          return `https://drive.google.com/uc?export=download&id=${m[1]}`;
  return url || '#';
}

const BS_ICON_PPT = '<svg width="46" height="46" fill="none" stroke="currentColor" stroke-width="1.7" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M7 21h10a2 2 0 002-2V9.414a1 1 0 00-.293-.707l-5.414-5.414A1 1 0 0012.586 3H7a2 2 0 00-2 2v14a2 2 0 002 2z"/><path stroke-linecap="round" stroke-linejoin="round" d="M9 12h3a1.5 1.5 0 010 3H9v-3zm0 0v5"/></svg>';
const BS_ICON_PDF = '<svg width="46" height="46" fill="none" stroke="currentColor" stroke-width="1.7" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M7 21h10a2 2 0 002-2V9.414a1 1 0 00-.293-.707l-5.414-5.414A1 1 0 0012.586 3H7a2 2 0 00-2 2v14a2 2 0 002 2z"/><path stroke-linecap="round" stroke-linejoin="round" d="M8 13h1.5M8 13v4m0-2h1.3M12 13v4m0-4h1a1 1 0 011 1v2a1 1 0 01-1 1h-1m4-4h1.5m-1.5 0v4m0-2h1.2"/></svg>';

function bsOpenPreview(item) {
  document.getElementById('bsModalTitle').textContent = bsCleanName(item.nom);
  document.getElementById('bsDocName').textContent = bsCleanName(item.nom);
  document.getElementById('bsDocIcon').innerHTML = item._type === 'pdf' ? BS_ICON_PDF : BS_ICON_PPT;
  const badge = document.getElementById('bsDocBadge');
  badge.className = 'bs-badge ' + (item._type === 'pdf' ? 'pdf' : 'ppt');
  badge.textContent = item._type === 'pdf' ? 'PDF' : 'PowerPoint';
  document.getElementById('bsOpenExternal').href = bsBuildOpenLink(item);
  document.getElementById('bsDownloadFile').href = bsBuildDownloadLink(item);
  document.getElementById('bsModalSrc').value = '';
  document.getElementById('bsModalOut').textContent = '';
  const hint = document.getElementById('bsImportHint');
  hint.textContent = 'Le texte du fichier importé (à gauche) apparaît ci-dessous. Vous pouvez aussi le coller manuellement.';
  hint.style.color = '';
  document.getElementById('bsModalStatus').textContent = '';

  // Réinitialise l'aperçu slide par slide
  bsSlidesData = [];
  bsPreviewLang = 'en';
  document.getElementById('bsSlides').innerHTML = '';
  document.getElementById('bsSlidesWrap').style.display = 'none';
  document.getElementById('bsDocCard').style.display = '';
  document.getElementById('bsLangToggle').style.display = 'none';

  const modal = document.getElementById('bsModal');
  modal.classList.add('open');
  modal.setAttribute('aria-hidden', 'false');
  document.body.style.overflow = 'hidden';
}

function bsClosePreview() {
  const modal = document.getElementById('bsModal');
  modal.classList.remove('open');
  modal.setAttribute('aria-hidden', 'true');
  document.body.style.overflow = '';
}

document.addEventListener('keydown', e => {
  if (e.key === 'Escape' && document.getElementById('bsModal').classList.contains('open')) bsClosePreview();
});

/* ── Extraction de texte côté navigateur ── */
function bsDecodeXml(s) {
  return s.replace(/&lt;/g,'<').replace(/&gt;/g,'>')
          .replace(/&quot;/g,'"').replace(/&apos;/g,"'").replace(/&amp;/g,'&');
}

/* ── Médias (images / vidéos) intégrés dans le .pptx ── */
const BS_IMG_EXT = ['png','jpg','jpeg','gif','bmp','webp','svg'];           // affichables par le navigateur
const BS_VID_EXT = ['mp4','webm','mov','m4v'];                              // lisibles par le navigateur
function bsMimeFor(ext) {
  return ({ png:'image/png', jpg:'image/jpeg', jpeg:'image/jpeg', gif:'image/gif', bmp:'image/bmp',
            webp:'image/webp', svg:'image/svg+xml', mp4:'video/mp4', webm:'video/webm',
            mov:'video/quicktime', m4v:'video/x-m4v' })[ext] || 'application/octet-stream';
}
/* Résout un chemin relatif de .rels (ex: "../media/image1.png") en chemin zip absolu */
function bsZipJoin(base, rel) {
  const parts = (base + rel).split('/'); const out = [];
  for (const p of parts) { if (p === '..') out.pop(); else if (p !== '.' && p !== '') out.push(p); }
  return out.join('/');
}

/* Extraction structurée : tableau [{label, en, media:[{kind,src,name}]}] (1 entrée / slide) */
async function bsExtractPptxSlides(file) {
  if (!window.JSZip) throw new Error('JSZip non chargé (vérifiez la connexion internet).');
  const zip = await JSZip.loadAsync(await file.arrayBuffer());
  const slideNames = Object.keys(zip.files)
    .filter(n => /ppt\/slides\/slide\d+\.xml$/.test(n))
    .sort((a, b) => (+a.match(/slide(\d+)/)[1]) - (+b.match(/slide(\d+)/)[1]));
  const slides = [];
  for (const name of slideNames) {
    const num = name.match(/slide(\d+)/)[1];
    const xml = await zip.files[name].async('string');
    const texts = [...xml.matchAll(/<a:t>([\s\S]*?)<\/a:t>/g)].map(m => bsDecodeXml(m[1]));

    // ── Cartographie des relations (rId → fichier média) ──
    const relsPath = 'ppt/slides/_rels/slide' + num + '.xml.rels';
    const relMap = {};
    if (zip.files[relsPath]) {
      const relsXml = await zip.files[relsPath].async('string');
      for (const r of relsXml.matchAll(/<Relationship\b[^>]*>/g)) {
        const tag = r[0];
        const id = (tag.match(/Id="([^"]+)"/) || [])[1];
        const target = (tag.match(/Target="([^"]+)"/) || [])[1];
        const external = /TargetMode="External"/.test(tag);
        if (id && target && !external) relMap[id] = target;
      }
    }

    // ── Médias référencés par la slide (dans l'ordre d'apparition) ──
    const media = [];
    const seen = new Set();
    for (const m of xml.matchAll(/r:(?:embed|link)="([^"]+)"/g)) {
      const id = m[1];
      if (seen.has(id)) continue; seen.add(id);
      const target = relMap[id];
      if (!target) continue;
      const path = bsZipJoin('ppt/slides/', target);
      const zf = zip.files[path];
      if (!zf) continue;
      const ext = path.split('.').pop().toLowerCase();
      const isVid = BS_VID_EXT.includes(ext);
      const isImg = BS_IMG_EXT.includes(ext);
      if (!isVid && !isImg) continue;   // formats non affichables (emf/wmf…) ignorés
      const b64 = await zf.async('base64');
      media.push({ kind: isVid ? 'video' : 'image', src: 'data:' + bsMimeFor(ext) + ';base64,' + b64, name: path.split('/').pop() });
    }

    slides.push({ label: 'Slide ' + num, en: texts.join(' ').trim(), media });
  }
  return slides;
}

async function bsExtractPdfSlides(file) {
  if (!window.pdfjsLib) throw new Error('pdf.js non chargé (vérifiez la connexion internet).');
  const pdf = await pdfjsLib.getDocument({ data: await file.arrayBuffer() }).promise;
  const slides = [];
  for (let i = 1; i <= pdf.numPages; i++) {
    const tc = await (await pdf.getPage(i)).getTextContent();
    slides.push({ label: 'Page ' + i, en: tc.items.map(it => it.str).join(' ').trim() });
  }
  return slides;
}

/* État de l'aperçu */
let bsSlidesData = [];     // [{label, en, fr|null}]
let bsPreviewLang = 'en';

async function bsHandleFileImport(file) {
  const name = (file.name || '').toLowerCase();
  bsSetImportStatus('Extraction de « ' + file.name + ' »…', '');
  try {
    let slides;
    if (name.endsWith('.pptx'))     slides = await bsExtractPptxSlides(file);
    else if (name.endsWith('.pdf')) slides = await bsExtractPdfSlides(file);
    else if (name.endsWith('.txt')) slides = [{ label: 'Texte', en: (await file.text()).trim() }];
    else throw new Error('Format non supporté (.pptx, .pdf ou .txt).');

    bsSlidesData = slides.map(s => ({ label: s.label, en: s.en, fr: null, media: s.media || [] }));

    // Remplit la zone source (droite) avec le texte complet
    document.getElementById('bsModalSrc').value =
      bsSlidesData.map(s => '— ' + s.label + ' —\n' + s.en).join('\n\n');

    // Construit l'aperçu (gauche)
    bsPreviewLang = 'en';
    bsRenderPreview();
    document.getElementById('bsDocCard').style.display = 'none';
    document.getElementById('bsSlidesWrap').style.display = 'block';
    document.getElementById('bsLangToggle').style.display = '';
    bsSetLangButtons('en');
    const unit = name.endsWith('.pdf') ? 'page(s)' : (name.endsWith('.txt') ? 'bloc' : 'slide(s)');
    document.getElementById('bsSlidesInfo').textContent = bsSlidesData.length + ' ' + unit + ' — aperçu généré ✓';
    bsSetImportStatus('Texte importé ✓ — basculez l\'aperçu en « Français », ou traduisez l\'ensemble ci-dessous.', 'ok');
  } catch (e) {
    bsSetImportStatus('Échec de l\'extraction : ' + e.message, 'err');
  }
}

function bsSetImportStatus(msg, kind) {
  const h = document.getElementById('bsImportHint');
  h.textContent = msg;
  h.style.color = kind === 'ok' ? 'var(--green)' : kind === 'err' ? 'var(--fd-red)' : '';
}

/* Applique le texte (EN ou FR) à un élément de slide */
function bsApplySlideText(el, s) {
  let txt, pending = false;
  if (bsPreviewLang === 'fr') {
    if (!s.en.trim())       txt = '(slide sans texte)';
    else if (s.fr === null){ txt = 'Traduction en cours…'; pending = true; }
    else                    txt = s.fr;
  } else {
    txt = s.en.trim() ? s.en : '(slide sans texte)';
  }
  el.textContent = txt;
  el.classList.toggle('pending', pending);
}

/* Rendu de l'aperçu slide par slide : texte + médias (images / vidéos) intégrés */
let bsSlideTextEls = [];
function bsRenderPreview() {
  const wrap = document.getElementById('bsSlides');
  wrap.innerHTML = '';
  bsSlideTextEls = [];
  bsSlidesData.forEach(s => {
    const div = document.createElement('div');
    div.className = 'bs-slide';

    const head = document.createElement('div');
    head.className = 'bs-slide-head';
    head.textContent = s.label;
    div.appendChild(head);

    const textEl = document.createElement('div');
    textEl.className = 'bs-slide-text';
    bsApplySlideText(textEl, s);
    div.appendChild(textEl);
    bsSlideTextEls.push(textEl);

    // Médias intégrés (photos / vidéos extraits du fichier)
    if (s.media && s.media.length) {
      const mw = document.createElement('div');
      mw.className = 'bs-slide-media';
      s.media.forEach(m => {
        if (m.kind === 'video') {
          const v = document.createElement('video');
          v.controls = true; v.preload = 'metadata'; v.src = m.src;
          mw.appendChild(v);
        } else {
          const img = document.createElement('img');
          img.src = m.src; img.alt = m.name; img.loading = 'lazy';
          mw.appendChild(img);
        }
      });
      div.appendChild(mw);
    }

    wrap.appendChild(div);
  });
}

function bsSetLangButtons(lang) {
  document.getElementById('bsLangEn').classList.toggle('active', lang === 'en');
  document.getElementById('bsLangFr').classList.toggle('active', lang === 'fr');
}

/* Bascule Anglais / Français de l'aperçu (traduit à la volée, avec cache) */
async function bsSetPreviewLang(lang) {
  if (lang === bsPreviewLang || !bsSlidesData.length) { bsSetLangButtons(lang); return; }
  bsPreviewLang = lang;
  bsSetLangButtons(lang);
  bsRenderPreview();
  if (lang !== 'fr') return;

  const todo = bsSlidesData.filter(s => s.en.trim() && s.fr === null);
  if (!todo.length) { bsRenderPreview(); return; }

  bsSetImportStatus('Traduction de l\'aperçu en cours…', '');
  try {
    for (let i = 0; i < bsSlidesData.length; i++) {
      const s = bsSlidesData[i];
      if (s.en.trim() && s.fr === null) {
        s.fr = await translateToFrench(s.en);
        // met à jour uniquement le texte (les médias ne sont pas rechargés)
        if (bsPreviewLang === 'fr' && bsSlideTextEls[i]) bsApplySlideText(bsSlideTextEls[i], s);
      }
    }
    bsSetImportStatus('Aperçu traduit en français ✓', 'ok');
  } catch (e) {
    bsSetImportStatus('Erreur de traduction : ' + e.message, 'err');
  }
}

/* ── Traduction dans la modale (réutilise translateToFrench) ── */
async function bsModalTranslate() {
  const input  = document.getElementById('bsModalSrc').value.trim();
  const output = document.getElementById('bsModalOut');
  const status = document.getElementById('bsModalStatus');
  if (!input) {
    status.textContent = 'Importez un fichier ou collez un texte d\'abord.';
    status.className = 'bs-tr-status warn';
    return;
  }
  status.textContent = 'Traduction en cours…';
  status.className = 'bs-tr-status';
  try {
    output.textContent = await translateToFrench(input);
    status.textContent = BS_TRANSLATE_CONNECTED
      ? 'Traduction terminée.'
      : 'Mode démonstration : connecteur de traduction non branché (voir translateToFrench()).';
    status.className = BS_TRANSLATE_CONNECTED ? 'bs-tr-status' : 'bs-tr-status warn';
  } catch (e) {
    output.textContent = '';
    status.textContent = 'Erreur de traduction : ' + e.message;
    status.className = 'bs-tr-status warn';
  }
}

function bsModalCopy() {
  const txt = document.getElementById('bsModalOut').textContent;
  if (!txt) { showToast('Rien à copier.'); return; }
  navigator.clipboard.writeText(txt).then(() => showToast('Traduction copiée ✓'))
    .catch(() => showToast('Copie impossible.'));
}

function bsModalClear() {
  document.getElementById('bsModalSrc').value = '';
  document.getElementById('bsModalOut').textContent = '';
  document.getElementById('bsModalStatus').textContent = '';
}

/* ══════════════════════════════════════════════════════════════
   DÉMARRAGE
══════════════════════════════════════════════════════════════ */
document.getElementById('bsSearch').addEventListener('input', renderResults);
document.getElementById('bsFileImport').addEventListener('change', e => {
  if (e.target.files && e.target.files[0]) bsHandleFileImport(e.target.files[0]);
  e.target.value = '';  // permet de ré-importer le même fichier
});

// Fallback local : charger manuellement l'export xlsx
document.getElementById('bsXlsxPick').addEventListener('change', e => {
  const file = e.target.files && e.target.files[0];
  if (!file) return;
  const rd = new FileReader();
  rd.onload = () => {
    try { bsApplyWorkbook(rd.result, file.lastModified ? 'maj ' + new Date(file.lastModified).toLocaleDateString('fr-FR') : null); }
    catch (err) { bsSetSync('err', 'Fichier illisible : ' + (err.message || err)); }
  };
  rd.readAsArrayBuffer(file);
  e.target.value = '';
});

loadBulletinExcel();
</script>
</body>
</html>
